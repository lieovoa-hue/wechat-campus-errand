/**
 * =====================================================================
 * 任务详情页样式（v6）
 * ---------------------------------------------------------------------
 * 信息层级：送达地址（主标题）+ 状态 → 酬金 / 限时（关键数字条）→ 明细表
 *          → 相关人员 → 图片 → 操作
 * 设计依据：docs/page-design-v1.md 第 07 / 08 页
 * 令牌全部取 app.wxss v6，页面内不写裸 hex。
 * ===================================================================== */

/* ---------------- 头部：地址标题 + 状态胶囊 ---------------- */
.td-head {
  display: flex;
  align-items: flex-start;
  padding: var(--sp-5);
  background: var(--surface-2);
  border-radius: var(--radius-m);
}

.td-addr {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-title);
  font-weight: 700;
  letter-spacing: -.5rpx;
  color: var(--text-1);
  line-height: 1.35;
  /* 地址最多两行：再长就交给下面的明细表，不让标题把首屏顶掉 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.td-head .tag {
  flex: none;
  margin-left: var(--sp-4);
  padding: 4rpx 16rpx;
  font-size: var(--fs-sm);
  border-radius: var(--radius-s);
}

/* ---------------- 关键数字条：酬金 + 限时 ---------------- */
.td-metrics {
  display: flex;
  align-items: stretch;
  margin-top: var(--sp-4);
  padding: var(--sp-5);
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-m);
}

.td-metric {
  flex: 1;
  min-width: 0;
}

.td-metric-r {
  border-left: 1rpx solid var(--line);
  padding-left: var(--sp-5);
  text-align: right;
}

.td-metric-k {
  display: block;
  font-size: var(--fs-cap);
  color: var(--text-3);
}

.td-metric-v {
  display: block;
  margin-top: 2rpx;
  font-size: var(--fs-h1);
  font-weight: 700;
  line-height: 1.2;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.td-metric-tip {
  display: block;
  margin-top: 2rpx;
  font-size: var(--fs-cap);
  color: var(--text-4);
}

/* ---------------- 订单号 ---------------- */
.order-no {
  margin-top: var(--sp-4);
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-sm);
  color: var(--text-3);
  background: var(--brand-soft);
  border-radius: var(--radius-s);
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

/* ---------------- 明细表 ---------------- */
/* 明细行改成「上下细线 + 固定行高」的表格语言，比一堆等距文本更好扫读 */
.info-row {
  display: flex;
  align-items: flex-start;
  min-height: 84rpx;
  padding: var(--sp-4) 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--line);
  font-size: var(--fs-md);
  line-height: 1.6;
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  flex: none;
  width: 170rpx;
  color: var(--text-3);
}

.info-value {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  color: var(--text-1);
}

/* info-value 内的管理员标识与文字保持一行对齐 */
.info-value .tag {
  margin-left: var(--sp-3);
}

/* 取件码：跑腿员取件凭证，加粗高亮便于在驿站快速核对 */
.pickup-code {
  font-weight: 700;
  color: var(--brand-deep);
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

/* ---------------- 举报入口 ---------------- */
/* 次要但明确的操作：淡红底 + 红字，比实心按钮克制，不会和主操作抢注意力 */
.report-card {
  background: var(--surface);
}

.report-btn {
  padding: var(--sp-2) var(--sp-6);
  border-radius: var(--radius-s);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--danger);
  background: var(--danger-soft);
  transition: transform var(--dur-fast) var(--ease-out),
              background var(--dur-fast) var(--ease-out);
}

.report-btn:active {
  transform: scale(.96);
  background: var(--danger-line);
}

/* ---------------- 管理员操作 ---------------- */
.admin-card {
  background: var(--danger-soft);
}

.admin-delete-btn {
  padding: var(--sp-2) var(--sp-6);
  border-radius: var(--radius-s);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-on-dark);
  background: var(--danger-fill);
  transition: transform var(--dur-fast) var(--ease-out),
              opacity var(--dur-fast) var(--ease-out);
}

.admin-delete-btn:active {
  transform: scale(.96);
  opacity: .9;
}

/* 任务已被管理员删除的顶部提示条 */
.delete-banner {
  background: var(--danger-soft);
}

.delete-banner-title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--danger);
}

/* 次级操作行：与上一行主操作只留一小段间距，视觉上仍属于同一组 */
.btn-row-tight {
  margin-top: var(--sp-3);
}

/* ---------------- 动效降级 ---------------- */
@media (prefers-reduced-motion: reduce) {
  .admin-delete-btn,
  .report-btn {
    transition-duration: 1ms;
  }
}


/* =====================================================================
 * v7 新增：任务类型标签 / 限时倒计时条 / 5 段进度条 / 联系方式 / 步骤标题
 * ---------------------------------------------------------------------
 * 配色口径与首页深色卡完全一致（filter.limitBarState + filter.progressSteps），
 * 页面只负责画，不再自己算档位；深浅两套主题都走 app.wxss 令牌 + .theme-dark 覆写。
 * ===================================================================== */

/* ---------------- 头部：类型标签 + 地址 ---------------- */
.td-head-main {
  flex: 1;
  min-width: 0;
}

/* 类型标签单独占一行：地址长度不可控，横排会把标签挤变形 */
.td-type-row {
  margin-bottom: var(--sp-3);
}

/* 任务类型标签：5 个槽位与 TASK_TYPE 字典一一对应（0其他 1取快递 2食堂带饭 3打印资料 4超市代买） */
.td-type-tag {
  display: inline-block;
  font-size: var(--fs-cap);
  line-height: 1.3;
  padding: 3rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--surface-3);
  color: var(--text-3);
}

.tag-type-0 { background: var(--surface-3); color: var(--text-3); }
.tag-type-1 { background: var(--brand-soft); color: var(--brand); }
.tag-type-2 { background: var(--warn-soft); color: var(--warn); }
.tag-type-3 { background: var(--success-soft); color: var(--success); }
.tag-type-4 { background: var(--purple-soft); color: var(--purple); }

/* ---------------- 限时倒计时条 ---------------- */
/* 满格 → 空，宽度按剩余比例实时变化；档位由 filter.limitBarState 统一给出：
   pending 灰蓝（待接单 / 不限时）· safe 绿 · warm 橙 · danger 红 · over 亮红 */
.td-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-top: var(--sp-4);
  padding: var(--sp-3) var(--sp-4);
  background: var(--surface-2);
  border-radius: var(--radius-s);
}

.td-bar-label {
  flex: none;
  font-size: var(--fs-cap);
  color: var(--text-3);
}

.td-bar-track {
  flex: 1;
  min-width: 0;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--surface-3);
  overflow: hidden;
}

.td-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  /* 每秒平滑推进，避免出现「一格一格跳」的卡顿感 */
  transition: width 1s linear, background-color var(--dur-base) var(--ease-out);
}

.td-bar-pending { background: linear-gradient(90deg, #94A3B8 0%, #CBD5E1 100%); }
.td-bar-safe    { background: linear-gradient(90deg, #16A34A 0%, #4ADE80 100%); }
.td-bar-warm    { background: linear-gradient(90deg, #D97706 0%, #FBBF24 100%); }
.td-bar-danger  { background: linear-gradient(90deg, #DC2626 0%, #F87171 100%); }
.td-bar-over    { background: linear-gradient(90deg, #EF4444 0%, #FF9B9B 100%); }

.td-bar-txt {
  flex: none;
  font-size: var(--fs-cap);
  line-height: 1.2;
  color: var(--text-3);
  /* 等宽数字：秒数变化时文字宽度不抖，右侧文字不会左右晃 */
  font-variant-numeric: tabular-nums;
}

.td-bar-txt-safe { color: var(--success); }
.td-bar-txt-warm { color: var(--warn); }
.td-bar-txt-danger,
.td-bar-txt-over { color: var(--danger); }

/* 深色底上浅色填充会「发灰」，所以整条换成高饱和渐变 + 亮文字 */
.theme-dark .td-bar-track { background: rgba(255, 255, 255, .12); }
.theme-dark .td-bar-pending { background: linear-gradient(90deg, #46567A 0%, #8296BC 100%); }
.theme-dark .td-bar-txt-safe { color: #86EFAC; }
.theme-dark .td-bar-txt-warm { color: #FCD34D; }
.theme-dark .td-bar-txt-danger,
.theme-dark .td-bar-txt-over { color: #FF9B9B; }

/* ---------------- 5 段进度条 ---------------- */
/* 第 1 段起最左侧出现接单人头像 +「已接单」小标，右侧是 5 个节点与连线 */
.td-flow {
  margin-top: var(--sp-4);
  padding: var(--sp-4);
  background: var(--surface-2);
  border-radius: var(--radius-s);
}

.td-flow-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-3);
}

.td-flow-title {
  font-size: var(--fs-sm);
  color: var(--text-3);
}

.td-flow-text {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--text-1);
}

/* 头像上面的「已接单」小标是绝对定位向上溢出的，这里必须留出头部空间 */
.td-flow-body {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  margin-top: var(--sp-8);
}

.td-flow-ava {
  position: relative;
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--surface-3);
  border: 1rpx solid var(--line-strong);
  box-sizing: border-box;
}

.td-flow-ava-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 头像加载失败 / 未设置头像时的兜底底色（保持圆形占位，不出现破图） */
.td-flow-ava-ph {
  background: linear-gradient(135deg, #7AA2FF 0%, #4B6BB5 100%);
}

.td-flow-ava-tag {
  position: absolute;
  left: 50%;
  bottom: 100%;
  transform: translateX(-50%);
  margin-bottom: 6rpx;
  white-space: nowrap;
  font-size: 16rpx;
  line-height: 1.4;
  padding: 2rpx 8rpx;
  border-radius: var(--radius-pill);
  background: var(--success-fill);
  color: #FFFFFF;
}

.td-steps {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
}

/* 连线：节点 5 等分，圆心正好落在 10% / 30% / 50% / 70% / 90% 处，
   所以底轨从 10% 铺到 90%，已走过的部分用绿色高亮覆盖上去 */
.td-steps-line,
.td-steps-line-on {
  position: absolute;
  top: 6rpx;
  height: 2rpx;
  border-radius: 2rpx;
}

.td-steps-line {
  left: 10%;
  right: 10%;
  background: var(--line-strong);
}

.td-steps-line-on {
  left: 10%;
  background: var(--success-fill);
  transition: width var(--dur-base) var(--ease-out);
}

.td-step {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.td-step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--line-strong);
  border: 1rpx solid var(--line-strong);
  transition: background-color var(--dur-base) var(--ease-out);
}

.td-step-dot-done {
  background: var(--success-fill);
  border-color: var(--success-fill);
}

/* 当前这一段：蓝点 + 外描边光圈，比「已走过」和「还没到」都更醒目 */
.td-step-dot-now {
  background: var(--brand);
  border-color: var(--brand-light);
  box-shadow: 0 0 0 4rpx rgba(43, 92, 230, .18);
}

.td-step-txt {
  font-size: 18rpx;
  line-height: 1.3;
  color: var(--text-4);
  white-space: nowrap;
}

.td-step-txt-done { color: var(--success); }
.td-step-txt-now { color: var(--text-1); font-weight: 600; }

.theme-dark .td-steps-line-on { background: #4ADE80; }
.theme-dark .td-step-dot-done { background: #4ADE80; border-color: #4ADE80; }
.theme-dark .td-step-dot-now {
  background: #7AA2FF;
  border-color: #DBEAFE;
  box-shadow: 0 0 0 4rpx rgba(122, 162, 255, .26);
}
.theme-dark .td-step-txt-done { color: #A7F3D0; }
.theme-dark .td-flow-ava { background: rgba(122, 162, 255, .26); border-color: rgba(147, 197, 253, .62); }
.theme-dark .td-flow-ava-tag { background: rgba(34, 197, 94, .92); }

/* 进度时间轴：已接单 10:28 · 已取货 10:35（没走到的那段不出现，不会出现一串「--」） */
.td-flow-times {
  margin-top: var(--sp-4);
  font-size: var(--fs-cap);
  color: var(--text-4);
  font-variant-numeric: tabular-nums;
}

/* ---------------- 卡片标题 + 锁定标识 ---------------- */
.td-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
}

/* 「已锁定」：绿色小胶囊，表示照片已确认取货、任何人不可再修改 */
.lock-chip {
  flex: none;
  padding: 2rpx 12rpx;
  font-size: var(--fs-cap);
  border-radius: var(--radius-pill);
  background: var(--success-soft);
  color: var(--success);
}

/* ---------------- 接单人分步操作 ---------------- */
.step-title {
  margin-top: var(--sp-6);
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--text-1);
}

/* 已确认取货：绿色说明条，替代原来的上传区（照片已锁定，不能再改） */
.lock-note {
  margin-top: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-sm);
  color: var(--success);
  background: var(--success-soft);
  border-radius: var(--radius-s);
}
