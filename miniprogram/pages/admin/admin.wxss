/* =====================================================================
   管理员后台样式（v6 · 品牌蓝 + iOS 分组列表）
   ---------------------------------------------------------------------
   后台信息密度高，统一用「分组灰底 + 白色卡片 + separator」的 iOS
   分组列表语言：卡片不描边、阴影极淡，靠底色差建立层级，
   让管理员在一屏里能扫到更多条记录。
   ===================================================================== */
.page {
  min-height: 100vh;
  background: var(--bg, #f5f7fa);
  padding-bottom: 40rpx;
}

/* 一级 Tab：6 个入口在一行内平分宽度，字号收紧后不再互相挤压 */
.tabs {
  display: flex;
  background: var(--surface, #ffffff);
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 0 8rpx;
  border-bottom: 1rpx solid var(--line, #e6eaf2);
}
.tab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 22rpx 0 18rpx;
  font-size: var(--fs-sm);
  white-space: nowrap;
  color: var(--text-2, #475569);
  position: relative;
  transition: color var(--dur-fast, 120ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
}
.tab-on {
  color: var(--brand, #2b5ce6);
  font-weight: 600;
}
/* 选中下划线：iOS 的细横线，不做渐变 */
.tab-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--brand, #2b5ce6);
}

/* 二级状态 Tab */
.sub-tabs {
  display: flex;
  padding: 20rpx 24rpx 0;
  gap: 16rpx;
}
.sub-tab {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 var(--sp-6);
  border-radius: var(--radius-pill);
  background: var(--surface, #ffffff);
  color: var(--text-2, #475569);
  font-size: var(--fs-sm);
  transition: background-color var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)),
    color var(--dur-base, 220ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
}
.sub-tab-on {
  background: var(--brand, #2b5ce6);
  color: var(--brand-on, #ffffff);
  font-weight: 600;
}
/* 搜索栏：iOS 灰色圆角搜索框 + 蓝色按钮 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 0;
  gap: 16rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: var(--surface-2);
  border-radius: var(--radius-m);
  padding: 0 var(--sp-5);
  font-size: var(--fs-body);
  box-sizing: border-box;
}
.search-btn {
  flex: none;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--brand, #2b5ce6);
  color: var(--brand-on, #ffffff);
  border-radius: var(--radius-m);
  font-size: var(--fs-body);
  transition: transform var(--dur-fast, 120ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
}
.search-btn:active {
  transform: scale(0.97);
}

/* 列表卡片 */
.list {
  padding: 20rpx 24rpx;
}
.card {
  background: var(--surface, #ffffff);
  border-radius: var(--radius-l, 28rpx);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  animation: ds-fade-up var(--dur-slow, 320ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)) backwards;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-title {
  font-size: var(--fs-lg, 30rpx);
  font-weight: 600;
  color: var(--text-1, #0f172a);
}
.row {
  display: flex;
  margin-top: 10rpx;
  font-size: var(--fs-body);
  line-height: 40rpx;
}
.label {
  width: 150rpx;
  color: var(--text-3, #6b7688);
  flex-shrink: 0;
}
.value {
  flex: 1;
  color: var(--text-1, #0f172a);
  word-break: break-all;
}
.value-danger {
  color: var(--danger, #c81e1e);
}
.value-success {
  color: var(--success, #0a7a54);
}
/* 订单号（GCPT+数字）用蓝色突出显示，便于管理员快速核对 */
.value-primary {
  color: var(--brand-deep, #2b5ce6);
}
/* 长文本块：iOS 内嵌分组灰底 */
.block-text {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--surface-2, #f1f4f9);
  border-radius: var(--radius-m);
}
.block-text .label {
  display: block;
  width: auto;
  margin-bottom: 8rpx;
}
.content {
  display: block;
  font-size: var(--fs-body);
  color: var(--text-1, #0f172a);
  line-height: 40rpx;
}
.content-reply {
  color: var(--brand-deep, #2b5ce6);
}

/* 图片凭证 */
.img-box {
  margin-top: 16rpx;
}
.proof-img {
  width: 260rpx;
  height: 260rpx;
  border-radius: var(--radius-s, 8rpx);
  background: var(--surface-3, #e6eaf2);
}
.img-tip {
  display: block;
  margin-top: var(--sp-2, 8rpx);
  font-size: var(--fs-cap);
  color: var(--text-3, #6b7688);
}

/* 状态标签：iOS 徽标（同色系淡底 + 深色字，一律不描边） */
.tag {
  /* 与 app.wxss 保持一致：flex 容器中标签背景框只包裹文字，避免被撑大 */
  display: inline-block;
  flex: none;
  align-self: center;
  width: fit-content;
  max-width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-s, 8rpx);
  font-size: var(--fs-cap);
  line-height: 1.6;
  background: var(--surface-3);
  color: var(--text-3, #6b7688);
}
.tag-warn {
  background: var(--warn-soft);
  color: var(--warn, #b45309);
}
.tag-success {
  background: var(--success-soft);
  color: var(--success, #0a7a54);
}
.tag-danger {
  background: var(--danger-soft);
  color: var(--danger, #c81e1e);
}
.tag-primary {
  background: var(--brand-soft);
  color: var(--brand-deep, #2b5ce6);
}

/* 操作按钮 */
.card-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line, #e6eaf2);
}
.btn {
  margin: 0;
  font-size: var(--fs-sm);
  border-radius: var(--radius-pill, 999rpx);
  padding: 0 var(--sp-6);
  /* 64rpx 高度保证指尖可点，同时不至于把弹窗按钮行撑高 */
  line-height: 64rpx;
  height: 64rpx;
  transition: transform var(--dur-fast, 120ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)),
    opacity var(--dur-fast, 120ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
}
/* iOS 次要按钮：浅灰底 + 蓝色字 */
.btn-plain {
  background: var(--surface-2, #f1f4f9);
  color: var(--brand-deep, #2b5ce6);
}
.btn-primary {
  background: var(--brand, #2b5ce6);
  color: var(--brand-on, #ffffff);
}
/* 未封禁用户的一键封禁按钮（封禁管理搜索命中后显示） */
.btn-danger {
  background: var(--danger-fill, #e02424);
  color: var(--brand-on, #ffffff);
}
.btn::after {
  border: none;
}
.btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* ============ 订单卡片操作区：等宽紧凑操作格 ============
   原来用 5 个原生 button，尺寸大、换行参差，小屏上非常挤；
   这里改成 flex 自动等分的小格子，图标 + 文案一行放下，视觉更整齐。 */
.order-ops {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line, #e6eaf2);
}
.order-ops .op {
  /* 固定三列：按钮宽度完全一致，4~5 个按钮时自动排成 3 + N，不会出现大小参差 */
  flex: none;
  width: calc((100% - 32rpx) / 3);
  /* 72rpx 高度：指尖足够好点，同时不让卡片被操作区撑高 */
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-m, 16rpx);
  font-size: var(--fs-sm);
  line-height: 1;
  transition: transform var(--dur-fast, 120ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)),
    background-color var(--dur-fast, 120ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
}
/* CSS 图标：按 32rpx 画布绘制，这里缩放 0.8 显示为约 26rpx，与 24rpx 文字齐平 */
.order-ops .op-ico {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  transform: scale(0.78);
  transform-origin: left top;
}
.order-ops .op-txt {
  font-size: var(--fs-sm);
}
.order-ops .op-hover {
  transform: scale(0.96);
  opacity: 0.85;
}
.op-plain {
  background: var(--surface-2, #f1f4f9);
  color: var(--brand-deep, #2b5ce6);
}
.op-primary {
  background: var(--brand-soft, #eef3ff);
  color: var(--brand-deep, #2b5ce6);
}
.op-danger {
  background: var(--danger-soft, #feecec);
  color: var(--danger, #c81e1e);
}

/* 空态 / 加载 */
.empty {
  text-align: center;
  color: var(--text-3, #6b7688);
  font-size: var(--fs-body);
  padding: 80rpx 0;
}
.loading-tip {
  text-align: center;
  color: var(--text-3, #6b7688);
  font-size: var(--fs-sm);
  padding: 20rpx 0;
}

/* =====================================================================
   封禁管理
   ===================================================================== */
.ban-tip {
  margin: var(--sp-5, 20rpx) var(--sp-6, 24rpx) 0;
  padding: var(--sp-4, 16rpx) var(--sp-5, 20rpx);
  background: var(--warn-soft, #fef3e2);
  border: 1rpx solid var(--warn-line);
  border-radius: var(--radius-m, 16rpx);
  color: var(--warn, #b45309);
  font-size: var(--fs-sm);
  line-height: 36rpx;
}

/* 自定义封禁时长输入：年 / 月 / 日 / 时 / 分 / 秒 */
.custom-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.custom-item {
  width: 156rpx;
  display: flex;
  align-items: center;
  background: var(--surface-2, #f1f4f9);
  border-radius: var(--radius-m, 16rpx);
  padding: 0 16rpx;
  height: 76rpx;
}
.custom-input {
  flex: 1;
  font-size: var(--fs-body);
  text-align: center;
  min-width: 0;
}
.custom-unit {
  font-size: var(--fs-sm);
  color: var(--text-3, #6b7688);
  margin-left: 4rpx;
}

/* =====================================================================
   用户管理：管理员修改用户资料
   ===================================================================== */
/* 弹窗内容较多（头像 + 5 个字段 + 认证状态下拉），限制高度并允许滚动，避免超出屏幕 */
.modal-body {
  max-height: 68vh;
  overflow-y: auto;
}

/* 用户列表头像 */
.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--surface-3, #e6eaf2);
  flex-shrink: 0;
}
.user-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-4, #9aa5b4);
  font-size: var(--fs-cap);
}

/* 编辑弹窗：头像一行 */
.edit-avatar-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.edit-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--surface-3, #e6eaf2);
  flex-shrink: 0;
}
.edit-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-4, #9aa5b4);
  font-size: var(--fs-body);
}
.edit-avatar-btns {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 编辑弹窗：单个字段一行（左标签 + 右输入框） */
.edit-field {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.edit-label {
  width: 110rpx;
  font-size: var(--fs-body);
  color: var(--text-1, #0f172a);
  flex-shrink: 0;
}
.edit-input {
  flex: 1;
  height: 80rpx;
  background: var(--surface-2, #f1f4f9);
  border-radius: var(--radius-m, 16rpx);
  padding: 0 var(--sp-5);
  font-size: var(--fs-body);
  box-sizing: border-box;
  min-width: 0;
}

/* 重置密码弹窗：后果提示（暖色警示条） */
.pwd-tip {
  margin-top: 20rpx;
  padding: var(--sp-4) var(--sp-5);
  background: var(--warn-soft, #fef3e2);
  border: 1rpx solid var(--warn-line);
  border-radius: var(--radius-m, 16rpx);
  color: var(--warn, #b45309);
  font-size: var(--fs-sm);
  line-height: 38rpx;
}

/* ============ 注销账号弹窗（不可恢复操作） ============ */
/* 风险说明：红色加粗，强调不可恢复 */
.deactivate-warn {
  margin-top: 16rpx;
  color: var(--danger, #c81e1e);
  font-weight: 600;
}

.deactivate-list {
  margin-top: 12rpx;
  font-size: var(--fs-body);
  color: var(--text-2, #475569);
  line-height: 1.7;
}

/* 弹窗内的「确认注销」按钮：红色，与风险等级匹配 */
.deactivate-ok {
  color: var(--danger, #c81e1e);
}
/* ============ 举报信息里的用户 mini 卡片 ============ */
.mini-title {
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  font-size: var(--fs-sm);
  color: var(--text-3, #6b7688);
}

.person-cards {
  display: block;
}

/* ============ 一键复制整条举报 ============ */
.copy-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--sp-5, 20rpx);
  padding: var(--sp-4, 16rpx);
  border-radius: var(--radius-m, 16rpx);
  font-size: var(--fs-sm);
  color: var(--brand-deep, #2b5ce6);
  background: var(--brand-soft, #eef3ff);
  transition: background-color var(--dur-fast, 120ms) var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
}

.copy-line-hover {
  background: var(--gray-5, #e6eaf2);
}

.copy-line-icon {
  margin-right: var(--sp-3);
  font-size: var(--fs-body);
}

/* ============ 订单管理（搜索 / 编辑 / 处罚 / 删除） ============ */
.order-tip {
  padding: 16rpx 32rpx 0;
  font-size: var(--fs-sm);
  line-height: 1.6;
  color: var(--text-3, #6b7688);
}

.thumb-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.thumb-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.thumb-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-s, 8rpx);
  background: var(--surface-3, #e6eaf2);
}

.thumb-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--scrim);
  color: #ffffff;
  font-size: var(--fs-lg);
}

.thumb-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-s, 8rpx);
  border: 1rpx dashed var(--line-strong, #d5dbe6);
  color: var(--text-4, #9aa5b4);
  font-size: var(--fs-display);
  line-height: 156rpx;
  text-align: center;
  background: var(--surface-2, #f1f4f9);
}

/* 订单编辑弹窗：字段较多，内容区可滚动，避免小屏机型按钮被挤出屏幕 */
.order-edit-body {
  max-height: 56vh;
  overflow-y: auto;
}

.order-edit-tip {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-cap);
  line-height: 1.5;
  color: var(--text-3, #6b7688);
}

.modal-tip {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: var(--radius-s, 8rpx);
  background: var(--surface-2, #f1f4f9);
  font-size: var(--fs-cap);
  line-height: 1.6;
  color: var(--text-3, #6b7688);
}

/* =====================================================================
   以下为本次新增：一级 Tab 横向滚动 / 批量删除 / 公告管理
   ===================================================================== */

/* 一级 Tab 增至 7 个（含「公告」）：横向滚动，避免窄屏把文字挤成两行 */
.tabs {
  overflow-x: auto;
  white-space: nowrap;
}

.tabs .tab {
  flex: none;
  padding-left: 22rpx;
  padding-right: 22rpx;
}

/* ---------------------------------------------------- 批量删除 */
.batch-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: var(--radius-m, 16rpx);
  background: var(--surface, #ffffff);
  border: 1rpx solid var(--line, #e6eaf2);
}

.batch-all {
  display: flex;
  align-items: center;
}

.batch-all-txt {
  font-size: var(--fs-sm);
  color: var(--text-2, #475569);
}

.batch-count {
  margin-left: 16rpx;
  font-size: var(--fs-cap, 22rpx);
  color: var(--text-3, #6b7688);
}

.batch-del {
  margin-left: auto;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--danger-soft, #feecec);
  color: var(--danger, #c81e1e);
  font-size: var(--fs-sm);
}

.batch-del:active {
  transform: scale(.96);
}

/* 勾选框：批量条里的「全选」与每张卡片上的行选择共用同一套外观 */
.batch-box {
  position: relative;
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--line-strong, #d5dbe6);
  background: var(--surface, #ffffff);
  box-sizing: border-box;
}

.batch-box-on {
  background: var(--brand, #2b5ce6);
  border-color: var(--brand, #2b5ce6);
}

/* 勾选后的对勾：用两条边框旋转 45 度画出来，不引入图片资源 */
.batch-box-on::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 4rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid var(--brand-on, #ffffff);
  border-bottom: 4rpx solid var(--brand-on, #ffffff);
  transform: rotate(45deg);
}

.batch-box-card {
  margin: 0 0 12rpx 0;
}

/* ---------------------------------------------------- 开关行（显示已注销 / 公告选项） */
.switcher {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 6rpx 0;
}

.switcher-txt {
  font-size: var(--fs-sm);
  color: var(--text-2, #475569);
}

/* ---------------------------------------------------- 公告管理表单 */
.announce-form {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-l, 20rpx);
  background: var(--surface, #ffffff);
  border: 1rpx solid var(--line, #e6eaf2);
}

.form-label {
  margin: 8rpx 0 12rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--text-1, #0f172a);
}

.scope-picker {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.scope-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--text-2, #475569);
  background: var(--surface-2, #f1f4f9);
  border: 2rpx solid transparent;
  border-radius: var(--radius-pill, 999rpx);
}

.scope-item-on {
  color: var(--brand-deep, #2b5ce6);
  background: var(--brand-soft, #eef3ff);
  border-color: var(--brand-line, #dce6ff);
  font-weight: 600;
}

.announce-input {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: var(--fs-sm);
  line-height: 1.6;
  color: var(--text-1, #0f172a);
  background: var(--surface-2, #f1f4f9);
  border-radius: var(--radius-m, 16rpx);
}

.announce-placeholder {
  color: var(--text-4, #9aa5b4);
}

.announce-times {
  display: flex;
  gap: 16rpx;
}

.announce-time {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  font-size: var(--fs-cap, 22rpx);
  color: var(--text-1, #0f172a);
  background: var(--surface-2, #f1f4f9);
  border-radius: var(--radius-m, 16rpx);
}

.announce-tip {
  margin: 12rpx 0 20rpx;
  font-size: var(--fs-cap, 22rpx);
  color: var(--text-3, #6b7688);
}

.announce-submit {
  margin-top: 8rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--brand, #2b5ce6);
  color: var(--brand-on, #ffffff);
  font-size: var(--fs-md, 30rpx);
  font-weight: 600;
}

.announce-submit:active {
  transform: scale(.98);
}
