  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.4",
    "node-schedule": "^2.1.1"
  },
  "optionalDependencies": {
    "bcrypt": "^5.1.1"
  }
}
