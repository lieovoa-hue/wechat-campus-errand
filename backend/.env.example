# ======================= 服务配置 =======================
PORT=3000
NODE_ENV=development

# ======================= 数据库配置 =======================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=campus_errand

# ======================= JWT 配置 =======================
JWT_SECRET=你的随机密钥字符串
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# ============== 管理员学号白名单（多个用逗号分隔） ==============
ADMIN_STUDENT_IDS=20240001,20240002

# ======================= 支付配置 =======================
# 支付模式：simulate=模拟支付（不调微信，点支付即成功）/ virtual=微信虚拟支付（个人主体B方案）
#           / api_v3=微信支付API v3（企业商户号方案，备用）
# 上线前必须改成 virtual 或 api_v3
PAY_MODE=simulate
# 兼容旧配置：只有 PAY_MODE 未设置时才读这个开关
PAY_SIMULATE=true
WX_APPID=你的小程序AppID
WX_APP_SECRET=你的小程序AppSecret
WX_MCH_ID=你的微信支付商户号
WX_API_V3_KEY=你的APIv3密钥
WX_CERT_PATH=./cert/apiclient_cert.pem
WX_KEY_PATH=./cert/apiclient_key.pem
WX_PLATFORM_CERT_PATH=./cert/wechatpay_platform_cert.pem
WX_MCH_SERIAL_NO=你的商户证书序列号
WX_NOTIFY_URL=https://你的公网域名/api/pay/notify

# ======================= 微信虚拟支付（个人主体 B 方案） =======================
# 【重要】虚拟支付不支持退款：任务撤销退的是「发布券」，不是现金。
# 详见 src/utils/constant.js 的 PAY_CHANNEL_ENUM 与 src/utils/virtualPay.js
# 未开通前请保持 PAY_MODE=simulate；开通后填入下面 3 项并把 PAY_MODE 改为 virtual
XPAY_OFFER_ID=虚拟支付商户号OfferID
XPAY_APP_KEY=现网AppKey
XPAY_COUPON_PRODUCT_ID=publish_coupon
# 单张发布券价格（分），必须与虚拟支付后台的道具单价一致
XPAY_COUPON_PRICE_FEN=10

# ======================= 订阅消息（任务进度通知） =======================
# 一次性订阅模板；留空表示不下发（站内信照常保留）
# 必须与 miniprogram/utils/subscribe.js 的 ORDER_TEMPLATE_ID 保持一致
WX_SUBSCRIBE_ORDER_TEMPLATE=MysxROXLrTdJkbrUAOoAttVuHz8YD3gnNLCj5jKKG2Ak
# developer=开发版 / trial=体验版 / formal=正式版
WX_SUBSCRIBE_STATE=formal


# ==================== 内容安全（UGC 文本检测） ====================
# 已开启。覆盖范围见 src/utils/wxSecCheck.js 头部注释：
#   发布/编辑任务的 6 个自由文本字段、昵称申请、举报原因与补充说明、申诉正文、公告正文。
# 实现说明：v2 接口必须带本小程序用户的真实 openid，代码会从 user_device 表取（带 5 分钟缓存）；
#          取不到 openid 时自动退回 v1 接口（v1 不需要 openid），管理员账号也能正常过检。
SEC_CHECK_ENABLE=true
# 微信侧异常（超时/网络错误）时的兜底：open=放行，closed=拦截并提示用户稍后重试
# 当前取 closed：内容安全优先，宁可让用户稍后重试，也不放过可能违规的文本
SEC_CHECK_FAIL_MODE=closed

# ======================= 短信配置 =======================
SMS_MOCK=true
SMS_ACCESS_KEY=阿里云AccessKey
SMS_ACCESS_SECRET=阿里云AccessSecret
SMS_SIGN_NAME=短信签名
SMS_TEMPLATE_CODE=短信模板CODE

# ======================= 上传配置 =======================
UPLOAD_MAX_SIZE=2097152

# ======================= 业务参数 =======================
SERVICE_FEE=0.10
EDIT_INTERVAL_MIN=3
CANCEL_TAKE_MIN=10
SCHEDULE_TICK_SEC=60

# ============= 接口限流（同一 IP 每小时上限，可用 .env 覆盖代码默认值） =============
# 校园网 / 内网穿透场景下大量用户共用一个出口 IP，正式环境请按实际用户量评估后调大。
CAPTCHA_HOURLY_LIMIT=60            # 图形验证码接口
ACCOUNT_HELPER_HOURLY_LIMIT=120    # 注册页「随机生成账号ID / 校验是否被占用」
REGISTER_IP_HOURLY_LIMIT=100       # 注册接口 IP 兜底限流
SECURITY_HOURLY_LIMIT=60           # 密保设置与校验相关接口

# ============= 图片地址签名有效期（小时） =============
# 接口下发的图片地址带时效签名，过期需重新拉接口；调大更省请求，调小更安全。
MEDIA_URL_WINDOW_HOURS=6

# ======================= 垃圾清理（定时任务） =======================
CLEAN_ENABLED=true                 # 关闭后所有清理任务只记录不动作
CLEAN_DRY_RUN=false                # true = 空跑，只输出将清理的清单
CLEAN_ORPHAN_KEEP_DAYS=7           # 无人引用的图片保留天数
CLEAN_TRASH_KEEP_DAYS=3            # 回收站图片保留天数
CLEAN_LOG_KEEP_DAYS=7              # 日志保留天数
CLEAN_LOG_MAX_MB=20                # 单个日志文件超过该大小自动切割
CLEAN_LOG_KEEP_LINES=2000          # 切割后保留的行数
CLEAN_SMS_KEEP_DAYS=7              # 短信记录保留天数

# ==================== 数据库每日备份 ====================
# 【为什么必须有】图片丢了还能让用户重传，数据库丢了整个平台就没了。
#   本机 MySQL 没有任何容灾能力（磁盘坏 / 误删库 / 误执行 SQL 都会毁掉全部业务数据），
#   定时全量逻辑备份（mysqldump）是最低成本的保险。
# 【什么时候跑】定时任务每天 05:00 自动执行（src/schedule/index.js -> jobBackupDb）
# 【手动执行】cd backend && node scripts/backupDb.js           （真备份）
#            cd backend && node scripts/backupDb.js --list     （只看现有备份）
# 【怎么恢复】mysql -u root -p < 备份文件.sql        （备份文件自带 CREATE DATABASE / USE）
# 总开关
BACKUP_ENABLED=true
# 备份目录：建议放在非系统盘（本机 D 盘），且不要放进项目目录，避免被 git / 清理脚本误伤
BACKUP_DIR=D:\backup\campus_errand
# 保留天数（超过即删除，只认 campus_errand_ 前缀的 .sql 文件）
BACKUP_KEEP_DAYS=14
# mysqldump 可执行文件路径；留空则自动探测（PATH → Windows/Linux 常见安装位置）
MYSQLDUMP_PATH=